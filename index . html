];

let evaluationResults = {};
let totalWrongProgramming = 0;
let totalWrongDesign = 0;
let totalAIDetected = 0;
let isRejected = false;

function evaluateAnswer(id) {
    const textarea = document.getElementById(id);
    const answer = textarea.value.trim();
    if (!answer || answer.length < 10) return null;

    const config = answerKeywords[id];
    if (!config) return null;

    const lower = answer.toLowerCase();
    const diff = config.difficulty;

    let matches = 0;
    config.keywords.forEach(kw => {
        if (lower.includes(kw.toLowerCase())) matches++;
    });

    const minReq = config.minKw[diff] || 2;
    const isCorrect = matches >= minReq;

    let aiScore = 0;
    aiIndicators.forEach(ind => {
        if (lower.includes(ind.toLowerCase())) aiScore++;
    });

    const sentences = answer.split(/[.!؟\n]/).filter(s => s.trim().length > 0);
    const avgLen = answer.length / Math.max(sentences.length, 1);
    if (avgLen > 100 && answer.length > 300) aiScore += 2;

    const transWords = ['أولاً', 'ثانياً', 'ثالثاً', 'بالإضافة', 'علاوة', 'وأخيراً', 'في الختام'];
    let transCount = 0;
    transWords.forEach(w => { if (lower.includes(w.toLowerCase())) transCount++; });
    if (transCount >= 3) aiScore += 2;

    const aiThresh = diff === 'hard' ? 4 : diff === 'medium' ? 3 : 2;
    const isAI = aiScore >= aiThresh;

    return { isCorrect, isAI, matches, aiScore, category: config.category, difficulty: diff };
}

function updateQuestionUI(id, result) {
    const box = document.getElementById('q-' + id);
    const tag = document.getElementById('tag-' + id);
    box.classList.remove('correct-q', 'wrong-q', 'ai-q');
    tag.classList.remove('show', 'ok', 'no', 'bot');
    if (!result) return;
    if (result.isAI) {
        box.classList.add('ai-q');
        tag.classList.add('show', 'bot');
        tag.textContent = '🤖 AI';
    } else if (result.isCorrect) {
        box.classList.add('correct-q');
        tag.classList.add('show', 'ok');
        tag.textContent = '✓ صحيح';
    } else {
        box.classList.add('wrong-q');
        tag.classList.add('show', 'no');
        tag.textContent = '✗ خاطئ';
    }
}

function updateStats() {
    let corr = 0, wrong = 0, ai = 0;
    totalWrongProgramming = 0;
    totalWrongDesign = 0;
    totalAIDetected = 0;

    Object.keys(evaluationResults).forEach(id => {
        const r = evaluationResults[id];
        if (!r) return;
        if (r.isAI) { ai++; totalAIDetected++; }
        else if (r.isCorrect) corr++;
        else {
            wrong++;
            if (r.category === 'programming') totalWrongProgramming++;
            else if (r.category === 'design') totalWrongDesign++;
        }
    });

    const total = Object.keys(answerKeywords).length;
    document.getElementById('totalQ').textContent = (corr + wrong + ai) + '/' + total;
    document.getElementById('corrC').textContent = corr;
    document.getElementById('wrongC').textContent = wrong;
    document.getElementById('aiC').textContent = ai;

    checkRejection();
}

function checkRejection() {
    const rejectDiv = document.getElementById('rejectMsg');
    const rejectReason = document.getElementById('rejectReason');
    const submitBtn = document.getElementById('submitBtn');
    let reject = false;
    let reasons = [];

    if (totalWrongProgramming > 4) {
        reject = true;
        reasons.push(`لديك ${totalWrongProgramming} إجابات خاطئة في البرمجة (الحد الأقصى 4)`);
    }
    if (totalWrongDesign > 4) {
        reject = true;
        reasons.push(`لديك ${totalWrongDesign} إجابات خاطئة في التصميم (الحد الأقصى 4)`);
    }
    if (totalAIDetected > 4) {
        reject = true;
        reasons.push(`تم اكتشاف ${totalAIDetected} إجابات ذكاء اصطناعي (الحد الأقصى 4)`);
    }

    if (reject) {
        rejectDiv.classList.add('show');
        rejectReason.innerHTML = reasons.join('<br>');
        submitBtn.disabled = true;
        submitBtn.textContent = '🚫 تم رفض الطلب تلقائياً';
        submitBtn.style.background = 'linear-gradient(135deg, #ef4444, #dc2626)';
        isRejected = true;
        showNotif('تم رفض الطلب تلقائياً بسبب تجاوز الحد المسموح', 'err');
    } else {
        rejectDiv.classList.remove('show');
        if (!isRejected) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'إرسال طلب الانخراط';
            submitBtn.style.background = 'linear-gradient(135deg, #06b6d4, #3b82f6)';
        }
    }
}

function showNotif(msg, type) {
    const n = document.getElementById('notif');
    n.textContent = msg;
    n.className = 'notif show ' + type;
    setTimeout(() => { n.className = 'notif'; }, 5000);
}

const timers = {};
function debouncedEval(id) {
    clearTimeout(timers[id]);
    timers[id] = setTimeout(() => {
        const r = evaluateAnswer(id);
        evaluationResults[id] = r;
        updateQuestionUI(id, r);
        updateStats();
    }, 1500);
}

Object.keys(answerKeywords).forEach(id => {
    const ta = document.getElementById(id);
    if (ta) {
        ta.addEventListener('input', () => debouncedEval(id));
        ta.addEventListener('blur', () => {
            clearTimeout(timers[id]);
            const r = evaluateAnswer(id);
            evaluationResults[id] = r;
            updateQuestionUI(id, r);
            updateStats();
        });
    }
});

// ============ معالجة تقديم النموذج ============
document.getElementById('regForm').addEventListener('submit', function(e) {
    e.preventDefault();
    if (isRejected) { showNotif('لا يمكن إرسال الطلب لأنه تم رفضه', 'err'); return; }

    const name = document.getElementById('fullName').value.trim();
    const email = document.getElementById('email').value.trim();
    const agree = document.getElementById('agreement').checked;

    if (!name) { showNotif('الرجاء إدخال الاسم واللقب', 'err'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showNotif('بريد إلكتروني غير صحيح', 'err'); return; }
    if (!agree) { showNotif('يجب الموافقة على القوانين', 'err'); return; }

    // التحقق من رفع الوثائق المطلوبة
    if (!uploadedFiles.bacFile) { showNotif('الرجاء رفع شهادة البكالوريا', 'err'); return; }
    if (!uploadedFiles.studyFile) { showNotif('الرجاء رفع الشهادة الدراسية', 'err'); return; }

    // إعادة تقييم جميع الإجابات
    Object.keys(answerKeywords).forEach(id => {
        const r = evaluateAnswer(id);
        evaluationResults[id] = r;
        updateQuestionUI(id, r);
    });
    updateStats();

    if (isRejected) { showNotif('تم رفض الطلب تلقائياً', 'err'); return; }

    // تجميع البيانات مع الصور
    const data = {
        name: name,
        email: email,
        bac: document.getElementById('bacGrade').value,
        // الصور بصيغة Base64
        bacCertificate: uploadedFiles.bacFile || '',
        studyCertificate: uploadedFiles.studyFile || '',
        otherCertificate: uploadedFiles.certFile || '',
        // الإجابات
        prog1: document.getElementById('prog1').value,
        prog2: document.getElementById('prog2').value,
        prog3: document.getElementById('prog3').value,
        prog4: document.getElementById('prog4').value,
        prog5: document.getElementById('prog5').value,
        design1: document.getElementById('design1').value,
        design2: document.getElementById('design2').value,
        design3: document.getElementById('design3').value,
        design4: document.getElementById('design4').value,
        design5: document.getElementById('design5').value,
        talents: document.getElementById('talents').value,
        whyClub: document.getElementById('whyClub').value,
        aspirations: document.getElementById('aspirations').value,
        // التقييم
        evalResults: JSON.stringify(evaluationResults),
        wrongProgramming: totalWrongProgramming,
        wrongDesign: totalWrongDesign,
        aiDetected: totalAIDetected,
        submissionDate: new Date().toISOString()
    };

    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = 'جاري الإرسال... <span class="spinner show"></span>';

    // ============ إرسال البيانات إلى Google Apps Script ============
    fetch("https://script.google.com/macros/s/AKfycby5JHdFE9G9mZatBs2yF2fGbB-DJMesSRGD5MbRzbn8Crpm8tJ2C0vMHkXgNjduNYCkfg/exec", {
        method: "POST",
        body: JSON.stringify(data),
        headers: {
            "Content-Type": "application/json"
        }
    })
    .then(res => res.json())
    .then(response => {
        console.log("تم حفظ التسجيل:", response);

        showNotif('✅ تم إرسال طلب الانخراط بنجاح! سنتواصل معك قريباً.', 'ok');

        btn.disabled = true;
        btn.textContent = 'تم الإرسال ✓';

        setTimeout(() => {
            document.getElementById('regForm').reset();
            evaluationResults = {};
            updateStats();

            Object.keys(answerKeywords).forEach(id => 
                updateQuestionUI(id, null)
            );

            // إعادة تعيين رفع الصور
            uploadedFiles.bacFile = null;
            uploadedFiles.studyFile = null;
            uploadedFiles.certFile = null;
            document.getElementById('bacUploadArea').classList.remove('has-file');
            document.getElementById('studyUploadArea').classList.remove('has-file');
            document.getElementById('certUploadArea').classList.remove('has-file');
            document.getElementById('bacFileName').style.display = 'none';
            document.getElementById('studyFileName').style.display = 'none';
            document.getElementById('certFileName').style.display = 'none';
            document.getElementById('bacPreview').classList.remove('show');
            document.getElementById('studyPreview').classList.remove('show');
            document.getElementById('certPreview').classList.remove('show');

            document.getElementById('rejectMsg').classList.remove('show');

            btn.disabled = false;
            btn.textContent = 'إرسال طلب الانخراط';
            btn.style.background = 'linear-gradient(135deg, #06b6d4, #3b82f6)';

            isRejected = false;

            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });

        }, 5000);
    })
    .catch(err => {
        console.error('خطأ في الإرسال:', err);
        showNotif('❌ حدث خطأ أثناء الإرسال. الرجاء المحاولة مرة أخرى.', 'err');
        btn.disabled = false;
        btn.textContent = 'إرسال طلب الانخراط';
        btn.style.background = 'linear-gradient(135deg, #06b6d4, #3b82f6)';
    });
});
</script>

