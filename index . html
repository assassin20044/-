<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PGDC - نادي البرمجة والتصميم الجرافيكي | تسجيل</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Cairo', sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #0f172a;
    color: white;
    overflow-x: hidden;
}

/* ========== شريط التنقل ========== */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(20px);
    z-index: 1000;
    padding: 12px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* شعار PGDC الجديد */
.pgdc-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    padding: 6px 14px;
    border-radius: 40px;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
}
.pgdc-logo i {
    font-size: 22px;
    color: white;
    text-shadow: 0 0 5px rgba(0,0,0,0.2);
}
.pgdc-text {
    font-weight: 900;
    font-size: 20px;
    letter-spacing: 1px;
    background: white;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.pgdc-sub {
    font-size: 10px;
    color: #e0f2fe;
    background: rgba(255,255,255,0.15);
    padding: 2px 8px;
    border-radius: 20px;
    font-weight: 600;
}

.nav-logo span {
    font-weight: 700;
    font-size: 16px;
    color: #cbd5e1;
}

.nav-links {
    display: flex;
    gap: 25px;
    list-style: none;
    align-items: center;
}

.nav-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8;
}

.nav-btn {
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    padding: 10px 22px;
    border-radius: 25px;
    color: white !important;
    font-weight: 700 !important;
    transition: 0.3s !important;
}

.nav-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

/* ========== القسم الرئيسي ========== */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 80px;
    position: relative;
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
}

.hero::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.1), transparent);
    border-radius: 50%;
    top: -150px;
    left: -150px;
}

.hero::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent);
    border-radius: 50%;
    bottom: -100px;
    right: -100px;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
}

/* شعار رئيسي جديد */
.hero-logo {
    margin-bottom: 25px;
    animation: heroFloat 3s ease-in-out infinite;
}
.main-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(145deg, #1e293b, #0f172a);
    padding: 20px 35px;
    border-radius: 70px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    box-shadow: 0 20px 35px -10px rgba(0,0,0,0.5), 0 0 0 2px rgba(6,182,212,0.1) inset;
}
.main-logo .logo-icon {
    font-size: 52px;
    background: linear-gradient(135deg, #38bdf8, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.main-logo h2 {
    font-size: 38px;
    font-weight: 900;
    letter-spacing: 3px;
    background: linear-gradient(135deg, #fff, #38bdf8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 5px 0 0;
}
.main-logo p {
    font-size: 11px;
    color: #94a3b8;
    letter-spacing: 1px;
}

@keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

.hero h1 {
    font-size: 46px;
    font-weight: 900;
    margin-bottom: 15px;
    background: linear-gradient(135deg, #38bdf8, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.3;
}

.hero p {
    font-size: 20px;
    color: #94a3b8;
    margin-bottom: 35px;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 16px 40px;
    border-radius: 50px;
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.4s;
    cursor: pointer;
    border: none;
    display: inline-block;
}

.btn-primary {
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    color: white;
    box-shadow: 0 8px 30px rgba(6, 182, 212, 0.3);
}

.btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 45px rgba(6, 182, 212, 0.5);
}

.btn-outline {
    background: transparent;
    color: white;
    border: 2px solid #38bdf8;
}

.btn-outline:hover {
    background: rgba(56, 189, 248, 0.1);
    transform: translateY(-4px);
}

/* ========== قسم المميزات ========== */
.features {
    padding: 80px 20px;
    background: #111827;
}

.section-header {
    text-align: center;
    margin-bottom: 50px;
}

.section-header h2 {
    font-size: 36px;
    color: #38bdf8;
    margin-bottom: 12px;
}

.section-header p {
    color: #94a3b8;
    font-size: 18px;
}

.features-grid {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.feature-card {
    background: #1e293b;
    padding: 35px 25px;
    border-radius: 20px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.05);
    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-8px);
    border-color: #38bdf8;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
}

.feature-icon {
    font-size: 45px;
    color: #38bdf8;
    margin-bottom: 18px;
}

.feature-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
    color: #f1f5f9;
}

.feature-card p {
    color: #94a3b8;
    line-height: 1.8;
    font-size: 14px;
}

/* ========== قسم الإحصائيات ========== */
.stats-section {
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    padding: 60px 20px;
    text-align: center;
}

.stats-grid {
    max-width: 900px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 30px;
}

.stat-box h3 {
    font-size: 45px;
    font-weight: 900;
    margin-bottom: 8px;
}

.stat-box p {
    font-size: 16px;
    opacity: 0.9;
}

/* ========== قسم التسجيل ========== */
.register-section {
    padding: 80px 20px;
    background: #0f172a;
}

.form-container {
    max-width: 900px;
    margin: auto;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 25px;
    padding: 40px;
    box-shadow: 0 0 40px rgba(0,0,0,0.3);
}

.form-logo {
    text-align: center;
    margin-bottom: 25px;
}
.form-logo .mini-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #1e293b;
    padding: 8px 20px;
    border-radius: 60px;
    border: 1px solid #334155;
}
.mini-logo i {
    font-size: 28px;
    color: #38bdf8;
}
.mini-logo .mini-text {
    font-weight: 800;
    font-size: 22px;
    background: linear-gradient(135deg, #38bdf8, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.mini-logo span:last-child {
    font-size: 12px;
    color: #94a3b8;
}

.form-title {
    text-align: center;
    margin-bottom: 8px;
    font-size: 34px;
    color: #38bdf8;
}

.form-subtitle {
    text-align: center;
    margin-bottom: 25px;
    color: #cbd5e1;
}

.qr-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    margin-bottom: 30px;
    padding: 18px;
    background: rgba(255,255,255,0.03);
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    flex-wrap: wrap;
}

.qr-box {
    background: white;
    padding: 12px;
    border-radius: 12px;
}

.qr-box canvas {
    display: block;
}

.qr-text h4 {
    color: #38bdf8;
    margin-bottom: 8px;
}

.qr-text p {
    color: #94a3b8;
    font-size: 13px;
}

.qr-text .link {
    color: #22d3ee;
    font-weight: bold;
}

.eval-stats {
    background: #111827;
    padding: 15px 20px;
    border-radius: 12px;
    margin-bottom: 25px;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 12px;
    border: 1px solid rgba(255,255,255,0.08);
}

.eval-stat {
    text-align: center;
}

.eval-stat .val {
    font-size: 22px;
    font-weight: bold;
}

.eval-stat .lbl {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 3px;
}

.val.total { color: #60a5fa; }
.val.correct { color: #4ade80; }
.val.wrong { color: #f87171; }
.val.ai { color: #fbbf24; }

.reject-msg {
    display: none;
    background: rgba(239, 68, 68, 0.15);
    border: 2px solid #ef4444;
    padding: 20px;
    border-radius: 15px;
    margin: 20px 0;
    text-align: center;
    animation: shake 0.5s ease;
}

.reject-msg.show {
    display: block;
}

.reject-msg .icon {
    font-size: 45px;
    margin-bottom: 10px;
}

.reject-msg h3 {
    color: #ef4444;
    margin-bottom: 8px;
}

.reject-msg p {
    color: #fca5a5;
}

.sec-title {
    margin: 30px 0 20px;
    font-size: 22px;
    color: #22d3ee;
    border-right: 5px solid #22d3ee;
    padding-right: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.diff-badge {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 15px;
    font-weight: 600;
}

.diff-easy { background: rgba(34,197,94,0.2); color: #4ade80; border: 1px solid #22c55e; }
.diff-medium { background: rgba(251,191,36,0.2); color: #fbbf24; border: 1px solid #f59e0b; }
.diff-hard { background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid #ef4444; }

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 12px;
    background: #1e293b;
    color: white;
    font-size: 15px;
}

.form-group textarea {
    resize: none;
    min-height: 110px;
}

/* ===== رفع الصور ===== */
.file-upload-wrapper {
    position: relative;
}

.file-upload-area {
    border: 2px dashed #334155;
    border-radius: 15px;
    padding: 30px 20px;
    text-align: center;
    cursor: pointer;
    transition: 0.3s;
    background: #1e293b;
}

.file-upload-area:hover {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.05);
}

.file-upload-area.has-file {
    border-color: #22c55e;
    border-style: solid;
    background: rgba(34, 197, 94, 0.05);
}

.file-upload-area i {
    font-size: 40px;
    color: #64748b;
    margin-bottom: 10px;
    display: block;
}

.file-upload-area.has-file i {
    color: #22c55e;
}

.file-upload-area .upload-text {
    color: #94a3b8;
    font-size: 14px;
}

.file-upload-area .upload-text strong {
    color: #38bdf8;
}

.file-upload-area .file-name {
    color: #4ade80;
    margin-top: 8px;
    font-weight: 600;
    display: none;
}

.file-upload-area.has-file .file-name {
    display: block;
}

.file-upload-area input[type="file"] {
    display: none;
}

.file-info {
    margin-top: 8px;
    font-size: 12px;
    color: #64748b;
}

.file-preview {
    max-width: 100%;
    max-height: 200px;
    border-radius: 10px;
    margin-top: 10px;
    display: none;
}

.file-preview.show {
    display: block;
}

.q-box {
    background: #0f172a;
    padding: 18px;
    border-radius: 15px;
    margin-bottom: 18px;
    border: 1px solid rgba(255,255,255,0.08);
    position: relative;
    transition: 0.3s;
}

.q-box h4 {
    margin-bottom: 12px;
    color: #38bdf8;
    padding-left: 45px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.q-num {
    background: rgba(56,189,248,0.2);
    color: #38bdf8;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: bold;
    flex-shrink: 0;
}

.eval-tag {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 4px 10px;
    border-radius: 15px;
    font-size: 11px;
    font-weight: bold;
    display: none;
    animation: fadeIn 0.4s ease;
}

.eval-tag.show { display: block; }
.eval-tag.ok { background: rgba(34,197,94,0.2); border: 1px solid #22c55e; color: #4ade80; }
.eval-tag.no { background: rgba(239,68,68,0.2); border: 1px solid #ef4444; color: #f87171; }
.eval-tag.bot { background: rgba(251,191,36,0.2); border: 1px solid #fbbf24; color: #fbbf24; }

.q-box.wrong-q { border-color: rgba(239,68,68,0.5); box-shadow: 0 0 12px rgba(239,68,68,0.1); }
.q-box.correct-q { border-color: rgba(34,197,94,0.5); box-shadow: 0 0 12px rgba(34,197,94,0.1); }
.q-box.ai-q { border-color: rgba(251,191,36,0.5); box-shadow: 0 0 12px rgba(251,191,36,0.1); }

.rules-box {
    background: #111827;
    padding: 22px;
    border-radius: 15px;
    margin-top: 25px;
    border: 1px solid rgba(255,255,255,0.08);
}

.rules-box ul {
    padding-right: 18px;
}

.rules-box li {
    margin-bottom: 12px;
    line-height: 1.8;
}

.checkbox-row {
    margin-top: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.checkbox-row input {
    width: auto;
}

.submit-btn {
    width: 100%;
    margin-top: 25px;
    padding: 16px;
    border: none;
    border-radius: 15px;
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    color: white;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    position: relative;
    overflow: hidden;
}

.submit-btn:hover {
    transform: scale(1.02);
}

.submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
}

.spinner {
    display: none;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 10px;
}

.spinner.show {
    display: inline-block;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.notif {
    display: none;
    padding: 14px 18px;
    border-radius: 12px;
    margin-bottom: 18px;
    text-align: center;
    font-weight: 600;
    animation: slideDown 0.5s ease-out;
}

.notif.show { display: block; }
.notif.ok { background: rgba(34,197,94,0.2); border: 1px solid #22c55e; color: #86efac; }
.notif.err { background: rgba(239,68,68,0.2); border: 1px solid #ef4444; color: #fca5a5; }
.notif.warn { background: rgba(251,191,36,0.2); border: 1px solid #fbbf24; color: #fde68a; }

.req-star { color: #ef4444; margin-right: 3px; }

/* ========== الفوتر ========== */
.footer {
    background: #020617;
    text-align: center;
    padding: 30px 20px;
    color: #64748b;
    border-top: 1px solid rgba(255,255,255,0.05);
}

.footer .social {
    margin-bottom: 15px;
    display: flex;
    justify-content: center;
    gap: 18px;
}

.footer .social a {
    color: #94a3b8;
    font-size: 22px;
    transition: 0.3s;
}

.footer .social a:hover {
    color: #38bdf8;
    transform: scale(1.2);
}

/* ========== حركات ========== */
@keyframes fadeIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
}

@keyframes slideDown {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
}

/* ========== تجاوب ========== */
@media (max-width: 768px) {

    body{
        overflow-x:hidden;
    }

    .navbar {
        padding: 10px 15px;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        width: 100%;
        background: rgba(15,23,42,0.98);
        flex-direction: column;
        padding: 20px;
        gap: 15px;
    }

    .nav-links.active {
        display: flex;
    }

    .menu-toggle {
        display: block;
    }

    .hero {
        padding: 120px 15px 60px;
    }

    .hero h1 {
        font-size: 28px;
        line-height: 1.5;
    }

    .hero p {
        font-size: 15px;
        line-height: 1.8;
    }

    .hero-buttons {
        flex-direction: column;
        width: 100%;
    }

    .btn {
        width: 100%;
        text-align: center;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }

    .form-container {
        padding: 18px;
        border-radius: 18px;
    }

    .form-title {
        font-size: 24px;
    }

    .sec-title {
        font-size: 18px;
    }

    .q-box h4 {
        font-size: 14px;
        padding-left: 0;
        line-height: 1.7;
    }

    textarea,
    input,
    select {
        font-size: 16px;
    }

    .qr-row {
        flex-direction: column;
        text-align: center;
    }

    .submit-btn {
        font-size: 16px;
    }
}
</style>
</head>
<body>

<!-- ========== شريط التنقل ========== -->
<nav class="navbar">
    <div class="nav-logo">
        <div class="pgdc-logo">
            <i class="fas fa-code"></i>
            <i class="fas fa-pen-fancy"></i>
            <div class="pgdc-text">PGDC</div>
            <div class="pgdc-sub">CLUB</div>
        </div>
        <span>نادي البرمجة والتصميم</span>
    </div>
    <button class="menu-toggle" onclick="document.querySelector('.nav-links').classList.toggle('active')">☰</button>
    <ul class="nav-links">
        <li><a href="#home">الرئيسية</a></li>
        <li><a href="#features">المميزات</a></li>
        <li><a href="#register" class="nav-btn">سجل الآن</a></li>
    </ul>
</nav>

<!-- ========== القسم الرئيسي ========== -->
<section class="hero" id="home">
    <div class="hero-content">
        <div class="hero-logo">
